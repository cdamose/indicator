get_shifted_day(int t) =>
    int d = dayofweek(t, 'America/New_York')
    int h = hour(t, 'America/New_York')
    if h >= 17
        d := d == 7 ? 1 : d + 1
    string out = switch d
        1 => "Sun"
        2 => "Mon"
        3 => "Tue"
        4 => "Wed"
        5 => "Thu"
        6 => "Fri"
        7 => "Sat"
        => ""
    out

get_week_of_month(int t) =>
    int dom = dayofmonth(t, 'America/New_York')
    int w = math.ceil(dom / 7)
    string suffix = w == 1 ? "st" : w == 2 ? "nd" : w == 3 ? "rd" : "th"
    str.tostring(w) + suffix + " Week"

