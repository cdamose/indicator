method DetectCandleSetSweeps(CandleSet candleSet, bool showChartSweep) =>
    bool allow_bull = settings.bias == "Auto" or settings.bias == "Bullish"
    bool allow_bear = settings.bias == "Auto" or settings.bias == "Bearish"

    if candleSet.candles.size() >= 2 and settings.sweep_show
        Candle c2 = candleSet.candles.get(0)
        Candle c1 = candleSet.candles.get(1)

        for cIdx = 0 to candleSet.candles.size() - 1
            Candle c = candleSet.candles.get(cIdx)
            if not na(c.sweep_lines) and c.sweep_lines.size() > 0
                for i = c.sweep_lines.size() - 1 to 0 by 1
                    bool isBull = c.sweep_is_bullish.get(i)
                    float lvl = c.sweep_c1_levels.get(i)
                    
                    bool permanentlyInvalid = false
                    if cIdx > 0
                        for j = cIdx - 1 to 1 by 1
                            Candle histC = candleSet.candles.get(j)
                            if isBull and histC.c <= lvl
                                permanentlyInvalid := true
                                break
                            else if not isBull and histC.c >= lvl
                                permanentlyInvalid := true
                                break
                                
                    if permanentlyInvalid
                        line.delete(c.sweep_lines.get(i))
                        c.sweep_lines.remove(i)
                        
                        line cl_cisd_c = c.cisd_chart_lines.get(i)
                        if not na(cl_cisd_c)
                            line.delete(cl_cisd_c)
                        c.cisd_chart_lines.remove(i)
                        
                        if not na(c.sweep_chart_lines) and c.sweep_chart_lines.size() > i
                            line cl = c.sweep_chart_lines.get(i)
                            if not na(cl)
                                line.delete(cl)
                            c.sweep_chart_lines.remove(i)
                            
                        c.sweep_c1_indices.remove(i)
                        c.sweep_is_bullish.remove(i)
                        c.sweep_c1_levels.remove(i)
                    else
                        bool temporarilyInvalid = false
                        if isBull and c2.c <= lvl
                            temporarilyInvalid := true
                        else if not isBull and c2.c >= lvl
                            temporarilyInvalid := true
                            
                        color cColor = temporarilyInvalid ? color_transparent : settings.sweep_color
                        line.set_color(c.sweep_lines.get(i), cColor)
                        if not na(c.sweep_chart_lines) and c.sweep_chart_lines.size() > i
                            line cl = c.sweep_chart_lines.get(i)
                            if not na(cl)
                                line.set_color(cl, cColor)

        bool bullishSweep = c2.l < c1.l and c2.c > c1.l and allow_bull
        bool bearishSweep = c2.h > c1.h and c2.c < c1.h and allow_bear

        if not na(c1.body) and not na(c2.body)
            bool alreadyHasBullSweep = false
            bool alreadyHasBearSweep = false
            
            if not na(c2.sweep_lines) and c2.sweep_lines.size() > 0
                for i = 0 to c2.sweep_lines.size() - 1 by 1
                    if c2.sweep_c1_indices.get(i) == c1.o_idx
                        if c2.sweep_is_bullish.get(i)
                            alreadyHasBullSweep := true
                        else
                            alreadyHasBearSweep := true

            int x1 = box.get_left(c1.body) + 1
            int x2 = box.get_right(c2.body)

            // 1. Draw Bullish Sweep
            if bullishSweep and not alreadyHasBullSweep
                float yLevelBull = c1.l
                line sweepLineBull = line.new(x1, yLevelBull, x2, yLevelBull, color = settings.sweep_color, style = helper.LineStyle(settings.sweep_style), width = settings.sweep_width)
                c2.sweep_lines.push(sweepLineBull)
                c2.cisd_chart_lines.push(line(na))
                
                if showChartSweep
                    int cx1 = c1.l_idx
                    line chartLineBull = line.new(cx1, yLevelBull, c2.c_idx + 1, yLevelBull, color = settings.sweep_color, style = helper.LineStyle(settings.sweep_style), width = settings.sweep_width)
                    if na(c2.sweep_chart_lines)
                        c2.sweep_chart_lines := array.new<line>()
                    c2.sweep_chart_lines.push(chartLineBull)
                else
                    if na(c2.sweep_chart_lines)
                        c2.sweep_chart_lines := array.new<line>()
                    c2.sweep_chart_lines.push(line(na))

                c2.sweep_c1_indices.push(c1.o_idx)
                c2.sweep_is_bullish.push(true)
                c2.sweep_c1_levels.push(yLevelBull)

            // 2. Draw Bearish Sweep
            if bearishSweep and not alreadyHasBearSweep
                float yLevelBear = c1.h
                line sweepLineBear = line.new(x1, yLevelBear, x2, yLevelBear, color = settings.sweep_color, style = helper.LineStyle(settings.sweep_style), width = settings.sweep_width)
                c2.sweep_lines.push(sweepLineBear)
                c2.cisd_chart_lines.push(line(na))
                
                if showChartSweep
                    int cx1 = c1.h_idx
                    line chartLineBear = line.new(cx1, yLevelBear, c2.c_idx + 1, yLevelBear, color = settings.sweep_color, style = helper.LineStyle(settings.sweep_style), width = settings.sweep_width)
                    if na(c2.sweep_chart_lines)
                        c2.sweep_chart_lines := array.new<line>()
                    c2.sweep_chart_lines.push(chartLineBear)
                else
                    if na(c2.sweep_chart_lines)
                        c2.sweep_chart_lines := array.new<line>()
                    c2.sweep_chart_lines.push(line(na))

                c2.sweep_c1_indices.push(c1.o_idx)
                c2.sweep_is_bullish.push(false)
                c2.sweep_c1_levels.push(yLevelBear)
    candleSet

method UpdateTime(CandleSet candleSet) =>
    if settings.htf_timer_show and (barstate.isrealtime or barstate.islast)
        string tmr = '(' + helper.RemainingTime(candleSet.settings.htf) + ')'
        if not na(candleSet.tfTimerTop)
            candleSet.tfTimerTop.set_text(tmr)
        if not na(candleSet.tfTimerBottom)
            candleSet.tfTimerBottom.set_text(tmr)
    candleSet

method _clearMidpoints(array<Midpoint> midpoints) =>
    if midpoints.size() > 0
        for i = midpoints.size() - 1 to 0
            Midpoint midpoint = midpoints.get(i)
            if not na(midpoint.htf_marker)
                line.delete(midpoint.htf_marker)
            if not na(midpoint.chart_marker)
                line.delete(midpoint.chart_marker)
            midpoints.remove(i)

method _createMidpoint(float midpoint_price, int next_period_end, CandleSet candleSet, int totalOffset, bool showChartMidpoint) =>
    Midpoint midpoint = Midpoint.new()
    midpoint.price := midpoint_price
    midpoint.end_idx := next_period_end
    int t_buffer = totalOffset + (settings.width + settings.buffer) * (candleSet.candles.size() - 1)
    midpoint.htf_marker := line.new(bar_index - settings.width + t_buffer, midpoint_price, bar_index + settings.width + t_buffer, midpoint_price, color=settings.midpoint_color, style=helper.LineStyle(settings.midpoint_style), width=settings.midpoint_width)
    if showChartMidpoint
        int chart_start_bar = candleSet.candles.size() > 1 ? candleSet.candles.get(1).o_idx : bar_index - 1
        int chart_end_bar = bar_index + 2
        midpoint.chart_marker := line.new(chart_start_bar, midpoint_price, chart_end_bar, midpoint_price, color=settings.midpoint_chart_color, style=helper.LineStyle(settings.midpoint_style), width=settings.midpoint_width)
        chart_midpoint_lines.push(midpoint.chart_marker)
    midpoint

method _cleanupExpiredMidpoints(CandleSet candleSet) =>
    if candleSet.active_midpoints.size() > 0
        for i = candleSet.active_midpoints.size() - 1 to 0
            Midpoint midpoint = candleSet.active_midpoints.get(i)
            if time > midpoint.end_idx
                if not na(midpoint.htf_marker)
                    line.delete(midpoint.htf_marker)
                if not na(midpoint.chart_marker)
                    line.delete(midpoint.chart_marker)
                candleSet.active_midpoints.remove(i)

method CheckMidpoints(CandleSet candleSet, int totalOffset, bool isNewHTFCandle, bool showChartMidpoint) =>
    if not settings.midpoint_show or candleSet.candles.size() < 2
        candleSet
    else
        Candle curr_candle = candleSet.candles.get(0)
        if na(curr_candle.midpoints)
            curr_candle.midpoints := array.new<Midpoint>()
        if isNewHTFCandle
            _clearMidpoints(candleSet.active_midpoints)
            _clearMidpoints(curr_candle.midpoints)
            Candle prev_candle = candleSet.candles.get(1)
            float midpoint_price = (prev_candle.h + prev_candle.l) / 2
            int next_period_end = curr_candle.o_time + timeframe.in_seconds(candleSet.settings.htf) * 1000
            Midpoint midpoint = _createMidpoint(midpoint_price, next_period_end, candleSet, totalOffset, showChartMidpoint)
            curr_candle.midpoints.push(midpoint)
            candleSet.active_midpoints.push(midpoint)
        if showChartMidpoint and candleSet.active_midpoints.size() > 0
            for i = 0 to candleSet.active_midpoints.size() - 1
                Midpoint midpoint = candleSet.active_midpoints.get(i)
                if not na(midpoint.chart_marker)
                    line.set_x2(midpoint.chart_marker, bar_index + 2)
        if barstate.islast and candleSet.active_midpoints.size() > 0
            _cleanupExpiredMidpoints(candleSet)
        candleSet

method Reorder(CandleSet candleSet, int offset) =>
    int set_size = candleSet.candles.size()
    
    if set_size > 0
        for i = set_size - 1 to 0 by 1
            Candle candle = candleSet.candles.get(i)
            int t_buffer = offset + (settings.width + settings.buffer) * (set_size - i - 1)
            box.set_left(candle.body, bar_index + t_buffer)
            box.set_right(candle.body, bar_index + settings.width + t_buffer)
            
            bool is_bull = candle.c >= candle.o
            color final_body = is_bull ? settings.bull_body : settings.bear_body
            
            if settings.enable_pc and candle.is_div
                final_body := is_bull ? settings.pc_bull : settings.pc_bear
                
            if settings.enable_psp and i > 0 and i < set_size - 1
                Candle c_right = candleSet.candles.get(i - 1)
                Candle c_left  = candleSet.candles.get(i + 1)
                bool isBullPSP = (candle.l < c_left.l) and (c_right.l >= candle.l) and candle.is_div
                bool isBearPSP = (candle.h > c_left.h) and (c_right.h <= candle.h) and candle.is_div
                if isBullPSP
                    final_body := settings.psp_bull
                else if isBearPSP
                    final_body := settings.psp_bear
                    
            box.set_bgcolor(candle.body, final_body)
            
            int x_pos = bar_index + math.round(settings.width / 2) + t_buffer
            line.set_x1(candle.wick_up, x_pos)
            line.set_x2(candle.wick_up, x_pos)
            line.set_x1(candle.wick_down, x_pos)
            line.set_x2(candle.wick_down, x_pos)

            if settings.daily_name 
                if not na(candle.dow_label)
                    candle.dow_label.set_y(candle.h)
                    candle.dow_label.set_x(x_pos)
                    candle.dow_label.set_text(candle.dow)
                else
                    candle.dow_label := label.new(x_pos, candle.h, candle.dow, color = color_transparent, textcolor = settings.global_text_color, style = label.style_label_down, size = settings.global_text_size)

            if settings.sweep_show and not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
                int c3WickX = bar_index + settings.width + t_buffer
                if i > 0
                    Candle c3Candle = candleSet.candles.get(i - 1)
                    int c3_t_buffer = offset + (settings.width + settings.buffer) * (set_size - (i - 1) - 1)
                    c3WickX := bar_index + math.round(settings.width / 2) + c3_t_buffer

                int c1_t_buffer = offset + (settings.width + settings.buffer) * (set_size - (i + 1) - 1)
                int c1WickX = bar_index + math.round(settings.width / 2) + c1_t_buffer

                for sweepIdx = candle.sweep_lines.size() - 1 to 0 by 1
                    line sweepLine = candle.sweep_lines.get(sweepIdx)
                    float c1Level = candle.sweep_c1_levels.get(sweepIdx)
                    if not na(sweepLine)
                        line.set_x1(sweepLine, c1WickX)
                        line.set_x2(sweepLine, c3WickX)
                        line.set_y1(sweepLine, c1Level)
                        line.set_y2(sweepLine, c1Level)
                        
                    if not na(candle.sweep_chart_lines) and candle.sweep_chart_lines.size() > sweepIdx
                        line chartLine = candle.sweep_chart_lines.get(sweepIdx)
                        if not na(chartLine)
                            line.set_x2(chartLine, candle.c_idx + 1)
            else
                clearAllHTFCandleSweeps(candle)

            if candle.midpoints.size() > 0
                for j = candle.midpoints.size() - 1 to 0
                    Midpoint midpoint = candle.midpoints.get(j)
                    if i == set_size - 1 and not na(midpoint.htf_marker)
                        line.delete(midpoint.htf_marker)
                        if not na(midpoint.chart_marker)
                            line.delete(midpoint.chart_marker)
                        candle.midpoints.remove(j)
                        continue
                    if not na(midpoint.htf_marker)
                        line.set_x1(midpoint.htf_marker, bar_index - settings.width + t_buffer)
                        line.set_x2(midpoint.htf_marker, bar_index + settings.width + t_buffer + 2)

            float mp_price = (candle.h + candle.l) / 2
            if not settings.midpoint_show and settings.midpoint_show_all
                int next_x_pos = x_pos
                if i > 0
                    int next_t_buffer = offset + (settings.width + settings.buffer) * (set_size - (i - 1) - 1)
                    next_x_pos := bar_index + math.round(settings.width / 2) + next_t_buffer
                else
                    next_x_pos := bar_index + settings.width + t_buffer

                if na(candle.midpoint_all_marker)
                    candle.midpoint_all_marker := line.new(x_pos, mp_price, next_x_pos, mp_price, color=settings.midpoint_color, style=helper.LineStyle(settings.midpoint_style), width=settings.midpoint_width)
                else
                    line.set_xy1(candle.midpoint_all_marker, x_pos, mp_price)
                    line.set_xy2(candle.midpoint_all_marker, next_x_pos, mp_price)
                    line.set_color(candle.midpoint_all_marker, settings.midpoint_color)
                    line.set_style(candle.midpoint_all_marker, helper.LineStyle(settings.midpoint_style))
                    line.set_width(candle.midpoint_all_marker, settings.midpoint_width)
            else
                if not na(candle.midpoint_all_marker)
                    line.delete(candle.midpoint_all_marker)
                    candle.midpoint_all_marker := line(na)

            bool is_profiler_target = settings.profiler_source == "HTF" + str.tostring(candleSet.tfNumber) or (settings.profiler_source == "Auto" and candleSet.settings.htf == auto_profiler_tf)

            if not settings.midpoint_show and settings.midpoint_all_chart_show and is_profiler_target
                int chart_x1 = candle.o_idx
                int chart_x2 = i > 0 ? candleSet.candles.get(i - 1).o_idx : bar_index + 1
                if na(candle.midpoint_all_chart_marker)
                    candle.midpoint_all_chart_marker := line.new(chart_x1, mp_price, chart_x2, mp_price, color=settings.midpoint_chart_color, style=helper.LineStyle(settings.midpoint_style), width=settings.midpoint_width)
                else
                    line.set_xy1(candle.midpoint_all_chart_marker, chart_x1, mp_price)
                    line.set_xy2(candle.midpoint_all_chart_marker, chart_x2, mp_price)
                    line.set_color(candle.midpoint_all_chart_marker, settings.midpoint_chart_color)
                    line.set_style(candle.midpoint_all_chart_marker, helper.LineStyle(settings.midpoint_style))
                    line.set_width(candle.midpoint_all_chart_marker, settings.midpoint_width)
            else
                if not na(candle.midpoint_all_chart_marker)
                    line.delete(candle.midpoint_all_chart_marker)
                    candle.midpoint_all_chart_marker := line(na)

            // --- C2 Label Evaluation & CISD Routing ---
            bool has_bull_sweep = false
            bool has_bear_sweep = false
            
            if settings.sweep_show and not na(candle.sweep_lines) and candle.sweep_lines.size() > 0
                for sweepIdx = 0 to candle.sweep_lines.size() - 1
                    bool isBull = candle.sweep_is_bullish.get(sweepIdx)
                    float lvl = candle.sweep_c1_levels.get(sweepIdx)
                    bool temporarilyInvalid = false
                    if isBull and candle.c <= lvl
                        temporarilyInvalid := true
                    else if not isBull and candle.c >= lvl
                        temporarilyInvalid := true
                    
                    if not temporarilyInvalid
                        if isBull
                            has_bull_sweep := true
                        else
                            has_bear_sweep := true
                            
                    // --- CISD LOGIC (Chart Only, Native LTF calculation) ---
                    int breakout_array_idx = -1
                    float cisd_lvl = na
                    int cisd_array_idx = -1
                    
                    if isBull
                        int offset_to_low = bar_index - candle.l_idx
                        if offset_to_low >= 0 and offset_to_low < 4900
                            bool found_bearish = false
                            for b = offset_to_low to math.min(offset_to_low + 50, 4999)
                                if close[b] <= open[b]
                                    found_bearish := true
                                    float body_high = math.max(open[b], close[b])
                                    if na(cisd_lvl) or body_high > cisd_lvl
                                        cisd_lvl := body_high
                                        cisd_array_idx := bar_index - b
                                else
                                    if found_bearish
                                        break
                            if not na(cisd_lvl)
                                for b = offset_to_low to 0 by 1
                                    if close[b] > cisd_lvl
                                        breakout_array_idx := bar_index - b
                                        break
                    else
                        int offset_to_high = bar_index - candle.h_idx
                        if offset_to_high >= 0 and offset_to_high < 4900
                            bool found_bullish = false
                            for b = offset_to_high to math.min(offset_to_high + 50, 4999)
                                if close[b] >= open[b]
                                    found_bullish := true
                                    float body_low = math.min(open[b], close[b])
                                    if na(cisd_lvl) or body_low < cisd_lvl
                                        cisd_lvl := body_low
                                        cisd_array_idx := bar_index - b
                                else
                                    if found_bullish
                                        break
                            if not na(cisd_lvl)
                                for b = offset_to_high to 0 by 1
                                    if close[b] < cisd_lvl
                                        breakout_array_idx := bar_index - b
                                        break
                                        
                    line cisd_chart_line = candle.cisd_chart_lines.get(sweepIdx)
                    
                    if breakout_array_idx != -1 and not temporarilyInvalid
                        if settings.cisd_show and is_profiler_target
                            int chart_cisd_x = cisd_array_idx
                            int chart_break_x = breakout_array_idx
                            color cColor = isBull ? settings.cisd_bull_color : settings.cisd_bear_color
                            
                            if na(cisd_chart_line)
                                cisd_chart_line := line.new(chart_cisd_x, cisd_lvl, chart_break_x, cisd_lvl, color=cColor, style=helper.LineStyle(settings.cisd_style), width=settings.cisd_width)
                                candle.cisd_chart_lines.set(sweepIdx, cisd_chart_line)
                            else
                                line.set_xy1(cisd_chart_line, chart_cisd_x, cisd_lvl)
                                line.set_xy2(cisd_chart_line, chart_break_x, cisd_lvl)
                                line.set_color(cisd_chart_line, cColor)
                        else
                            if not na(cisd_chart_line)
                                line.delete(cisd_chart_line)
                                candle.cisd_chart_lines.set(sweepIdx, line(na))
                    else
                        if not na(cisd_chart_line)
                            line.delete(cisd_chart_line)
                            candle.cisd_chart_lines.set(sweepIdx, line(na))

            // BULLISH C2 LABELS
            if has_bull_sweep
                // 1. HTF Label (Shows on ALL HTF blocks regardless of Profiler)
                if settings.c2_label_show
                    if na(candle.c2_htf_label_bull)
                        candle.c2_htf_label_bull := label.new(x_pos, candle.l, "C2", color=color_transparent, textcolor=settings.c2_label_color, style=label.style_label_up, size=settings.global_text_size)
                    else
                        label.set_xy(candle.c2_htf_label_bull, x_pos, candle.l)
                        label.set_textcolor(candle.c2_htf_label_bull, settings.c2_label_color)
                else if not na(candle.c2_htf_label_bull)
                    label.delete(candle.c2_htf_label_bull)
                    candle.c2_htf_label_bull := label(na)

                // 2. Chart Label (Strictly respects Profiler Source via 'is_profiler_target')
                if settings.c2_chart_label_show and is_profiler_target
                    if na(candle.c2_chart_label_bull)
                        candle.c2_chart_label_bull := label.new(candle.l_idx, candle.l, "C2", color=color_transparent, textcolor=settings.c2_label_color, style=label.style_label_up, size=settings.global_text_size)
                    else
                        label.set_xy(candle.c2_chart_label_bull, candle.l_idx, candle.l)
                        label.set_textcolor(candle.c2_chart_label_bull, settings.c2_label_color)
                else if not na(candle.c2_chart_label_bull)
                    label.delete(candle.c2_chart_label_bull)
                    candle.c2_chart_label_bull := label(na)
            else
                if not na(candle.c2_htf_label_bull)
                    label.delete(candle.c2_htf_label_bull)
                    candle.c2_htf_label_bull := label(na)
                if not na(candle.c2_chart_label_bull)
                    label.delete(candle.c2_chart_label_bull)
                    candle.c2_chart_label_bull := label(na)

            // BEARISH C2 LABELS
            if has_bear_sweep
                // 1. HTF Label (Shows on ALL HTF blocks regardless of Profiler)
                if settings.c2_label_show
                    if na(candle.c2_htf_label_bear)
                        candle.c2_htf_label_bear := label.new(x_pos, candle.h, "C2", color=color_transparent, textcolor=settings.c2_label_color, style=label.style_label_down, size=settings.global_text_size)
                    else
                        label.set_xy(candle.c2_htf_label_bear, x_pos, candle.h)
                        label.set_textcolor(candle.c2_htf_label_bear, settings.c2_label_color)
                else if not na(candle.c2_htf_label_bear)
                    label.delete(candle.c2_htf_label_bear)
                    candle.c2_htf_label_bear := label(na)

                // 2. Chart Label (Strictly respects Profiler Source via 'is_profiler_target')
                if settings.c2_chart_label_show and is_profiler_target
                    if na(candle.c2_chart_label_bear)
                        candle.c2_chart_label_bear := label.new(candle.h_idx, candle.h, "C2", color=color_transparent, textcolor=settings.c2_label_color, style=label.style_label_down, size=settings.global_text_size)
                    else
                        label.set_xy(candle.c2_chart_label_bear, candle.h_idx, candle.h)
                        label.set_textcolor(candle.c2_chart_label_bear, settings.c2_label_color)
                else if not na(candle.c2_chart_label_bear)
                    label.delete(candle.c2_chart_label_bear)
                    candle.c2_chart_label_bear := label(na)
            else
                if not na(candle.c2_htf_label_bear)
                    label.delete(candle.c2_htf_label_bear)
                    candle.c2_htf_label_bear := label(na)
                if not na(candle.c2_chart_label_bear)
                    label.delete(candle.c2_chart_label_bear)
                    candle.c2_chart_label_bear := label(na)

    float top = 0.0
    float bottom = 0.0
    if settings.label_alignment == 'Align'
        top := helper.CandlesHigh(candleSet.candles)
        bottom := helper.CandlesLow(candleSet.candles, top)
    if settings.label_alignment == 'Follow Candles'
        top := helper.CandleSetHigh(candleSet.candles, 0)
        bottom := helper.CandleSetLow(candleSet.candles, top)

    int left = bar_index + offset + math.round((settings.width + settings.buffer) * (set_size - 1) / 2)

    if settings.htf_label_show
        string lblt = helper.HTFName(candleSet.settings.htf)
        string lbll = lblt
        string tmr = '(' + helper.RemainingTime(candleSet.settings.htf) + ')' + (settings.daily_name ? '\n' : '')
        
        if settings.htf_timer_show
            lblt := lblt + '\n'
            lbll := '\n' + lbll
            
        if settings.daily_name
            lblt := lblt + '\n'
            
        if settings.label_position == 'Both' or settings.label_position == 'Top'
            if not na(candleSet.tfNameTop)
                candleSet.tfNameTop.set_xy(left, top)
            else
                candleSet.tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = settings.global_text_color, style = label.style_label_down, size = settings.global_text_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerTop)
                    candleSet.tfTimerTop.set_xy(left, top)
                else
                    candleSet.tfTimerTop := label.new(left, top, tmr, color = color_transparent, textcolor = settings.global_text_color, style = label.style_label_down, size = settings.global_text_size)
        if settings.label_position == 'Both' or settings.label_position == 'Bottom'
            if not na(candleSet.tfNameBottom)
                candleSet.tfNameBottom.set_xy(left, bottom)
            else
                candleSet.tfNameBottom := label.new(left, bottom, lbll, color = color_transparent, textcolor = settings.global_text_color, style = label.style_label_up, size = settings.global_text_size)
            if settings.htf_timer_show
                if not na(candleSet.tfTimerBottom)
                    candleSet.tfTimerBottom.set_xy(left, bottom)
                else
                    candleSet.tfTimerBottom := label.new(left, bottom, tmr, color = color_transparent, textcolor = settings.global_text_color, style = label.style_label_up, size = settings.global_text_size)
    candleSet

method FindImbalance(CandleSet candleSet) =>
    bool allow_bull = settings.bias == "Auto" or settings.bias == "Bullish"
    bool allow_bear = settings.bias == "Auto" or settings.bias == "Bearish"

    if barstate.isrealtime or barstate.islast
        int imb_idx = 0 
        
        // 1. STANDARD FVG DETECTION
        if candleSet.candles.size() > 3 and settings.fvg_show
            for i = 0 to candleSet.candles.size() - 3 by 1
                Candle candle1 = candleSet.candles.get(i)
                Candle candle2 = candleSet.candles.get(i + 2)
                Candle candle3 = candleSet.candles.get(i + 1)
                
                bool is_bull_fvg = candle1.l > candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c) and allow_bull
                bool is_bear_fvg = candle1.h < candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c) and allow_bear
                
                if is_bull_fvg or is_bear_fvg
                    bool is_invalidated = false
                    if i > 0
                        for m = i - 1 to 0 by 1
                            Candle future_c = candleSet.candles.get(m)
                            if is_bull_fvg and future_c.c < candle2.h
                                is_invalidated := true
                                break
                            if is_bear_fvg and future_c.c > candle2.l
                                is_invalidated := true
                                break
                                
                    if is_invalidated
                        is_bull_fvg := false
                        is_bear_fvg := false
                
                if is_bull_fvg or is_bear_fvg
                    float t_top = is_bull_fvg ? candle2.h : candle1.h
                    float t_bot = is_bull_fvg ? candle1.l : candle2.l
                    int t_left = is_bull_fvg ? box.get_left(candle2.body) : box.get_right(candle1.body)
                    int t_right = is_bull_fvg ? box.get_right(candle1.body) : box.get_left(candle2.body)
                    
                    if imb_idx < candleSet.imbalances.size()
                        Imbalance imb = candleSet.imbalances.get(imb_idx)
                        box.set_lefttop(imb.b, t_left, t_top)
                        box.set_rightbottom(imb.b, t_right, t_bot)
                        box.set_bgcolor(imb.b, settings.fvg_color)
                    else
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(t_left, t_top, t_right, t_bot, bgcolor = settings.fvg_color, border_color = color_transparent)
                        candleSet.imbalances.push(imb)
                    imb_idx += 1

        // 2. VOLUME IMBALANCE (GAP) DETECTION
        if candleSet.candles.size() > 2 and settings.vi_show
            for i = 0 to candleSet.candles.size() - 2 by 1
                Candle candle1 = candleSet.candles.get(i)
                Candle candle2 = candleSet.candles.get(i + 1)
                
                bool is_bull_vi = candle1.l < candle2.h and math.min(candle1.o, candle1.c) > math.max(candle2.o, candle2.c) and allow_bull
                bool is_bear_vi = candle1.h > candle2.l and math.max(candle1.o, candle1.c) < math.min(candle2.o, candle2.c) and allow_bear
                
                if is_bull_vi or is_bear_vi
                    bool is_invalidated = false
                    if i > 0
                        for m = i - 1 to 0 by 1
                            Candle future_c = candleSet.candles.get(m)
                            if is_bull_vi and future_c.c < math.max(candle2.o, candle2.c)
                                is_invalidated := true
                                break
                            if is_bear_vi and future_c.c > math.min(candle2.o, candle2.c)
                                is_invalidated := true
                                break
                                
                    if is_invalidated
                        is_bull_vi := false
                        is_bear_vi := false
                
                if is_bull_vi or is_bear_vi
                    float t_top = is_bull_vi ? math.min(candle1.o, candle1.c) : math.min(candle2.o, candle2.c)
                    float t_bot = is_bull_vi ? math.max(candle2.o, candle2.c) : math.max(candle1.o, candle1.c)
                    int t_left = is_bull_vi ? box.get_left(candle2.body) : box.get_right(candle1.body)
                    int t_right = is_bull_vi ? box.get_right(candle1.body) : box.get_left(candle2.body)
                    
                    if imb_idx < candleSet.imbalances.size()
                        Imbalance imb = candleSet.imbalances.get(imb_idx)
                        box.set_lefttop(imb.b, t_left, t_top)
                        box.set_rightbottom(imb.b, t_right, t_bot)
                        box.set_bgcolor(imb.b, settings.vi_color)
                    else
                        Imbalance imb = Imbalance.new()
                        imb.b := box.new(t_left, t_top, t_right, t_bot, bgcolor = settings.vi_color, border_color = color_transparent)
                        candleSet.imbalances.push(imb)
                    imb_idx += 1

        while candleSet.imbalances.size() > imb_idx
            Imbalance del = candleSet.imbalances.pop()
            box.delete(del.b)
            
    candleSet

method Monitor(CandleSet candleSet, int offset, bool showChartSweep, bool isNewHTFCandle, float ltf_c) =>
    if isNewHTFCandle
        Candle candle = Candle.new()
        candle.o := open
        candle.c := close
        candle.h := high
        candle.l := low
        candle.o_time := time
        candle.o_idx := bar_index
        candle.c_idx := bar_index
        candle.h_idx := bar_index
        candle.l_idx := bar_index
        candle.h_time := time
        candle.l_time := time

        candle.corr1_h := na
        candle.corr1_l := na
        candle.corr2_h := na
        candle.corr2_l := na
        candle.corr3_h := na
        candle.corr3_l := na
        candle.is_div  := false
        candle.max_ltf_c := ltf_c
        candle.min_ltf_c := ltf_c
        
        candle.dow := switch
            candleSet.settings.htf == '1D' => helper.DayofWeek(dayofweek(time_tradingday, "America/New_York"))
            str.tonumber(candleSet.settings.htf) < 60 => str.format_time(candle.o_time, 'm', 'America/New_York')
            str.tonumber(candleSet.settings.htf) >= 60 => str.format_time(candle.o_time, 'H', 'America/New_York')
            candleSet.settings.htf == '1M' => str.format_time(candle.o_time, 'M', 'America/New_York')
            => ''
        bool bull = candle.c >= candle.o
        color bodyColor = bull ? settings.bull_body : settings.bear_body
        candle.body := box.new(bar_index, math.max(candle.o, candle.c), bar_index + 2, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bodyColor)
        candle.wick_up := line.new(bar_index + 1, candle.h, bar_index, math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick)
        candle.wick_down := line.new(bar_index + 1, math.min(candle.o, candle.c), bar_index, candle.l, color = bull ? settings.bull_wick : settings.bear_wick)
        candle.midpoints := array.new<Midpoint>()
        candle.midpoint_all_marker := line(na)
        candle.midpoint_all_chart_marker := line(na)
        candle.sweep_lines := array.new<line>()
        candle.sweep_chart_lines := array.new<line>()
        candle.sweep_c1_indices := array.new<int>()
        candle.sweep_is_bullish := array.new<bool>()
        candle.sweep_c1_levels := array.new<float>()
        candle.c2_htf_label_bull := label(na)
        candle.c2_chart_label_bull := label(na)
        candle.c2_htf_label_bear := label(na)
        candle.c2_chart_label_bear := label(na)
        candle.cisd_chart_lines := array.new<line>()
        candleSet.candles.unshift(candle)
        candleSet.DetectCandleSetSweeps(showChartSweep)
        
        int limit = candleSet.settings.max_display
        if settings.tspot_show
            bool is_tspot_target = false
            if settings.profiler_source == 'Auto' and candleSet.settings.htf == auto_profiler_tf
                is_tspot_target := true
            else if settings.profiler_source == 'HTF' + str.tostring(candleSet.tfNumber)
                is_tspot_target := true
            if is_tspot_target
                int tspot_req = settings.tspot_history > 0 ? settings.tspot_history : candleSet.settings.max_display
                limit := math.max(limit, tspot_req + 1)
                
        if candleSet.candles.size() > limit
            Candle delCandle = array.pop(candleSet.candles)
            clearAllHTFCandleSweeps(delCandle)
            if delCandle.midpoints.size() > 0
                for i = delCandle.midpoints.size() - 1 to 0
                    Midpoint mp = delCandle.midpoints.get(i)
                    if not na(mp.htf_marker)
                        line.delete(mp.htf_marker)
                    if not na(mp.chart_marker)
                        line.delete(mp.chart_marker)
            box.delete(delCandle.body)
            line.delete(delCandle.wick_up)
            line.delete(delCandle.wick_down)
            if not na(delCandle.dow_label)
                delCandle.dow_label.delete()
            if not na(delCandle.midpoint_all_marker)
                line.delete(delCandle.midpoint_all_marker)
            if not na(delCandle.midpoint_all_chart_marker)
                line.delete(delCandle.midpoint_all_chart_marker)
    candleSet

method Update(CandleSet candleSet, int offset, bool showChartSweep, float c1_h, float c1_l, float c2_h, float c2_l, float c3_h, float c3_l, bool s1_bull, bool s2_bull, bool s3_bull, float ltf_c) =>
    if candleSet.candles.size() > 0
        Candle candle = candleSet.candles.first()
        candle.h_time := high > candle.h ? time : candle.h_time
        candle.h_idx := high > candle.h ? bar_index : candle.h_idx
        candle.h := high > candle.h ? high : candle.h
        candle.l_time := low < candle.l ? time : candle.l_time
        candle.l_idx := low < candle.l ? bar_index : candle.l_idx
        candle.l := low < candle.l ? low : candle.l
        candle.c := close
        candle.c_idx := bar_index
        bool bull = candle.c >= candle.o
        
        candle.corr1_h := c1_h > nz(candle.corr1_h, c1_h) ? c1_h : nz(candle.corr1_h, c1_h)
        candle.corr1_l := c1_l < nz(candle.corr1_l, c1_l) ? c1_l : nz(candle.corr1_l, c1_l)
        candle.corr2_h := c2_h > nz(candle.corr2_h, c2_h) ? c2_h : nz(candle.corr2_h, c2_h)
        candle.corr2_l := c2_l < nz(candle.corr2_l, c2_l) ? c2_l : nz(candle.corr2_l, c2_l)
        candle.corr3_h := c3_h > nz(candle.corr3_h, c3_h) ? c3_h : nz(candle.corr3_h, c3_h)
        candle.corr3_l := c3_l < nz(candle.corr3_l, c3_l) ? c3_l : nz(candle.corr3_l, c3_l)
        
        candle.max_ltf_c := math.max(nz(candle.max_ltf_c, ltf_c), ltf_c)
        candle.min_ltf_c := math.min(nz(candle.min_ltf_c, ltf_c), ltf_c)

        int currVal = candle.c >= candle.o ? 1 : -1
        int p_norm1 = sec_sym != "" ? ((inv_sec ? not s1_bull : s1_bull) ? 1 : -1) : currVal
        int p_norm2 = ter_sym != "" ? ((inv_ter ? not s2_bull : s2_bull) ? 1 : -1) : currVal
        int p_norm3 = qua_sym != "" ? ((inv_qua ? not s3_bull : s3_bull) ? 1 : -1) : currVal

        bool isDiv_final = false
        if sec_sym != "" and currVal != p_norm1
            isDiv_final := true
        if ter_sym != "" and currVal != p_norm2
            isDiv_final := true
        if qua_sym != "" and currVal != p_norm3
            isDiv_final := true
        if sec_sym != "" and ter_sym != "" and p_norm1 != p_norm2
            isDiv_final := true
        if sec_sym != "" and qua_sym != "" and p_norm1 != p_norm3
            isDiv_final := true
        if ter_sym != "" and qua_sym != "" and p_norm2 != p_norm3
            isDiv_final := true
            
        candle.is_div := isDiv_final

        color borderColor = bull ? settings.bull_border : settings.bear_border
        color wickColor   = bull ? settings.bull_wick   : settings.bear_wick

        box.set_top(candle.body, candle.o)
        box.set_bottom(candle.body, candle.c)
        box.set_border_color(candle.body, borderColor)
        line.set_color(candle.wick_up, wickColor)
        line.set_color(candle.wick_down, wickColor)
        line.set_y1(candle.wick_up, candle.h)
        line.set_y2(candle.wick_up, math.max(candle.o, candle.c))
        line.set_y1(candle.wick_down, candle.l)
        line.set_y2(candle.wick_down, math.min(candle.o, candle.c))
        
        candleSet.DetectCandleSetSweeps(showChartSweep)
        
        if barstate.isrealtime or barstate.islast
            candleSet.Reorder(offset)
    candleSet

method DrawSMT(CandleSet candleSet, int totalOffset) =>
    bool allow_bull = settings.bias == "Auto" or settings.bias == "Bullish"
    bool allow_bear = settings.bias == "Auto" or settings.bias == "Bearish"

    if barstate.isrealtime or barstate.islast
        if not na(candleSet.smt_lines_htf) and candleSet.smt_lines_htf.size() > 0
            for i = candleSet.smt_lines_htf.size() - 1 to 0
                line.delete(candleSet.smt_lines_htf.pop())
        if not na(candleSet.smt_lines_chart) and candleSet.smt_lines_chart.size() > 0
            for i = candleSet.smt_lines_chart.size() - 1 to 0
                line.delete(candleSet.smt_lines_chart.pop())
        if not na(candleSet.smt_labels_chart) and candleSet.smt_labels_chart.size() > 0
            for i = candleSet.smt_labels_chart.size() - 1 to 0
                label.delete(candleSet.smt_labels_chart.pop())
        
        int n = candleSet.candles.size()
        string c_htf = candleSet.settings.htf
        string ltf_tf = get_ltf_tf(c_htf)
        
        if c_htf == "1D"
            c_htf := "D"
        else if c_htf == "1W"
            c_htf := "W"
        else if c_htf == "1M"
            c_htf := "M"
            
        bool is_visible_htf = candleSet.settings.show
        bool can_draw_on_chart = false
        
        if settings.show_smt_chart
            if settings.show_smt_all_tf == "Manual"
                if not is_visible_htf
                    can_draw_on_chart := true
            else
                if is_visible_htf
                    if settings.show_smt_all_tf == "Auto"
                        int tf_m = timeframe.multiplier
                        if timeframe.isminutes
                            if tf_m == 1 and array.includes(array.from("15", "30", "60", "240", "360", "720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m == 3 and array.includes(array.from("30", "60", "240", "360", "720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m == 5 and array.includes(array.from("60", "240", "360", "720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m == 15 and array.includes(array.from("240", "360", "720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m >= 30 and tf_m <= 59 and array.includes(array.from("360", "720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m >= 60 and tf_m <= 180 and array.includes(array.from("720", "D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                            else if tf_m >= 240 and tf_m <= 360 and array.includes(array.from("D", "W", "M"), c_htf)
                                can_draw_on_chart := true
                        else if timeframe.isdaily and tf_m == 1 and array.includes(array.from("W", "M"), c_htf)
                            can_draw_on_chart := true
                    else if settings.show_smt_all_tf == "Off"
                        string allowed_smt_tf = ""
                        if timeframe.isminutes
                            if timeframe.multiplier == 1
                                allowed_smt_tf := "15"
                            else if timeframe.multiplier == 3
                                allowed_smt_tf := "30"
                            else if timeframe.multiplier == 5
                                allowed_smt_tf := "60"
                            else if timeframe.multiplier == 15
                                allowed_smt_tf := "240"
                            else if timeframe.multiplier == 30
                                allowed_smt_tf := "360"
                            else if timeframe.multiplier == 60
                                allowed_smt_tf := "D"
                            else if timeframe.multiplier == 240
                                allowed_smt_tf := "W"
                        else if timeframe.isdaily and timeframe.multiplier == 1
                            allowed_smt_tf := "M"
                            
                        can_draw_on_chart := (c_htf == allowed_smt_tf)
    
        if n >= 2
            // --- LTF Close Invalidation Pre-calculation ---
            array<float> max_ltf = array.new<float>(n, -999999.0)
            array<float> min_ltf = array.new<float>(n, 999999.0)
            if n > 0
                float r_max = -999999.0
                float r_min = 999999.0
                for k = 0 to n - 1
                    Candle c = candleSet.candles.get(k)
                    r_max := math.max(r_max, nz(c.max_ltf_c, c.h))
                    r_min := math.min(r_min, nz(c.min_ltf_c, c.l))
                    max_ltf.set(k, r_max)
                    min_ltf.set(k, r_min)

            // Filtering Arrays to keep only the highest/lowest converging SMTs
            array<int> final_bear_j = array.new<int>()
            array<int> final_bear_i = array.new<int>()
            array<bool> final_bear_c1 = array.new<bool>()
            array<bool> final_bear_c2 = array.new<bool>()
            array<bool> final_bear_c3 = array.new<bool>()

            array<int> final_bull_j = array.new<int>()
            array<int> final_bull_i = array.new<int>()
            array<bool> final_bull_c1 = array.new<bool>()
            array<bool> final_bull_c2 = array.new<bool>()
            array<bool> final_bull_c3 = array.new<bool>()

            for j = n - 1 to 1
                Candle c_older = candleSet.candles.get(j)
                
                int best_i_bear = -1
                float best_bear_h = -999999.0
                bool best_bear_smt_c1 = false
                bool best_bear_smt_c2 = false
                bool best_bear_smt_c3 = false
                
                int best_i_bull = -1
                float best_bull_l = 999999.0
                bool best_bull_smt_c1 = false
                bool best_bull_smt_c2 = false
                bool best_bull_smt_c3 = false
                
                float tol = 0 
                
                bool bear_valid = true
                bool bull_valid = true
                
                for i = j - 1 to 0
                    Candle c_newer = candleSet.candles.get(i)
                    
                    // 1. Evaluate Bearish SMT
                    if corr_mode != "Off" and allow_bear and bear_valid
                        float p_h_trend  = c_newer.h - c_older.h
                        float c1_h_trend = c_newer.corr1_h - c_older.corr1_h
                        float c2_h_trend = c_newer.corr2_h - c_older.corr2_h
                        float c3_h_trend = c_newer.corr3_h - c_older.corr3_h
                        
                        bool smt_c1 = sec_sym != "" and ((p_h_trend > tol and c1_h_trend < -tol) or (p_h_trend < -tol and c1_h_trend > tol))
                        bool smt_c2 = ter_sym != "" and ((p_h_trend > tol and c2_h_trend < -tol) or (p_h_trend < -tol and c2_h_trend > tol))
                        bool smt_c3 = qua_sym != "" and ((p_h_trend > tol and c3_h_trend < -tol) or (p_h_trend < -tol and c3_h_trend > tol))
                        
                        if smt_c1 or smt_c2 or smt_c3
                            if best_i_bear == -1 or c_newer.h > best_bear_h
                                best_bear_h := c_newer.h
                                best_i_bear := i
                                best_bear_smt_c1 := smt_c1
                                best_bear_smt_c2 := smt_c2
                                best_bear_smt_c3 := smt_c3
                                
                        // UNIVERSAL INVALIDATION: A high is only dead if ALL tracked assets sweep it.
                        bool main_swept = c_newer.h > c_older.h
                        bool sec_swept  = sec_sym == "" or c_newer.corr1_h > c_older.corr1_h
                        bool ter_swept  = ter_sym == "" or c_newer.corr2_h > c_older.corr2_h
                        bool qua_swept  = qua_sym == "" or c_newer.corr3_h > c_older.corr3_h
                        
                        if main_swept and sec_swept and ter_swept and qua_swept
                            bear_valid := false
    
                    // 2. Evaluate Bullish SMT
                    if corr_mode != "Off" and allow_bull and bull_valid
                        float p_l_trend  = c_newer.l - c_older.l
                        float c1_l_trend = c_newer.corr1_l - c_older.corr1_l
                        float c2_l_trend = c_newer.corr2_l - c_older.corr2_l
                        float c3_l_trend = c_newer.corr3_l - c_older.corr3_l
                        
                        bool smt_c1 = sec_sym != "" and ((p_l_trend < -tol and c1_l_trend > tol) or (p_l_trend > tol and c1_l_trend < -tol))
                        bool smt_c2 = ter_sym != "" and ((p_l_trend < -tol and c2_l_trend > tol) or (p_l_trend > tol and c2_l_trend < -tol))
                        bool smt_c3 = qua_sym != "" and ((p_l_trend < -tol and c3_l_trend > tol) or (p_l_trend > tol and c3_l_trend < -tol))
                            
                        if smt_c1 or smt_c2 or smt_c3
                            if best_i_bull == -1 or c_newer.l < best_bull_l
                                best_bull_l := c_newer.l
                                best_i_bull := i
                                best_bull_smt_c1 := smt_c1
                                best_bull_smt_c2 := smt_c2
                                best_bull_smt_c3 := smt_c3
                                
                        // UNIVERSAL INVALIDATION: A low is only dead if ALL tracked assets sweep it.
                        bool main_swept_l = c_newer.l < c_older.l
                        bool sec_swept_l  = sec_sym == "" or c_newer.corr1_l < c_older.corr1_l
                        bool ter_swept_l  = ter_sym == "" or c_newer.corr2_l < c_older.corr2_l
                        bool qua_swept_l  = qua_sym == "" or c_newer.corr3_l < c_older.corr3_l
                        
                        if main_swept_l and sec_swept_l and ter_swept_l and qua_swept_l
                            bull_valid := false
                                
                // LTF Close Invalidation
                if best_i_bear != -1
                    float ext_h = math.max(c_older.h, candleSet.candles.get(best_i_bear).h)
                    if max_ltf.get(j) > ext_h
                        best_i_bear := -1 // Hide it! LTF closed above SMT extreme.
                        
                if best_i_bull != -1
                    float ext_l = math.min(c_older.l, candleSet.candles.get(best_i_bull).l)
                    if min_ltf.get(j) < ext_l
                        best_i_bull := -1 // Hide it! LTF closed below SMT extreme.
                                
                // Add Bear to Filtering Queue
                if best_i_bear != -1
                    bool found = false
                    if final_bear_i.size() > 0
                        for k = 0 to final_bear_i.size() - 1
                            if final_bear_i.get(k) == best_i_bear
                                found := true
                                Candle existing_older = candleSet.candles.get(final_bear_j.get(k))
                                if c_older.h > existing_older.h // Keep Highest
                                    final_bear_j.set(k, j)
                                    final_bear_c1.set(k, best_bear_smt_c1)
                                    final_bear_c2.set(k, best_bear_smt_c2)
                                    final_bear_c3.set(k, best_bear_smt_c3)
                                break
                    if not found
                        final_bear_j.push(j)
                        final_bear_i.push(best_i_bear)
                        final_bear_c1.push(best_bear_smt_c1)
                        final_bear_c2.push(best_bear_smt_c2)
                        final_bear_c3.push(best_bear_smt_c3)

                // Add Bull to Filtering Queue
                if best_i_bull != -1
                    bool found = false
                    if final_bull_i.size() > 0
                        for k = 0 to final_bull_i.size() - 1
                            if final_bull_i.get(k) == best_i_bull
                                found := true
                                Candle existing_older = candleSet.candles.get(final_bull_j.get(k))
                                if c_older.l < existing_older.l // Keep Lowest
                                    final_bull_j.set(k, j)
                                    final_bull_c1.set(k, best_bull_smt_c1)
                                    final_bull_c2.set(k, best_bull_smt_c2)
                                    final_bull_c3.set(k, best_bull_smt_c3)
                                break
                    if not found
                        final_bull_j.push(j)
                        final_bull_i.push(best_i_bull)
                        final_bull_c1.push(best_bull_smt_c1)
                        final_bull_c2.push(best_bull_smt_c2)
                        final_bull_c3.push(best_bull_smt_c3)

            // Execute Drawing (Bearish SMTs)
            if final_bear_j.size() > 0
                for k = 0 to final_bear_j.size() - 1
                    int j_bear = final_bear_j.get(k)
                    int i_bear = final_bear_i.get(k)
                    Candle c_older = candleSet.candles.get(j_bear)
                    Candle c_newer_best = candleSet.candles.get(i_bear)
                    bool b_c1 = final_bear_c1.get(k)
                    bool b_c2 = final_bear_c2.get(k)
                    bool b_c3 = final_bear_c3.get(k)

                    if settings.show_smt_htf and is_visible_htf
                        int x1_htf = bar_index + totalOffset + (settings.width + settings.buffer) * (n - 1 - j_bear) + math.round(settings.width / 2)
