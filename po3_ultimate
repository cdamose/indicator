    candleSet

method TrackSMT(CandleSet cSet, bool isNew, float c1_h, float c1_l, float c2_h, float c2_l, float c3_h, float c3_l, float ltf_c) =>
    if isNew
        Candle c = Candle.new()
        c.h := high, c.l := low, c.h_idx := bar_index, c.l_idx := bar_index
        c.h_time := time, c.l_time := time
        c.corr1_h := c1_h, c.corr1_l := c1_l
        c.corr2_h := c2_h, c.corr2_l := c2_l
        c.corr3_h := c3_h, c.corr3_l := c3_l
        
        c.midpoints := array.new<Midpoint>()
        c.sweep_lines := array.new<line>()
        c.sweep_chart_lines := array.new<line>()
        c.sweep_c1_indices := array.new<int>()
        c.sweep_is_bullish := array.new<bool>()
        c.sweep_c1_levels := array.new<float>()
        c.c2_htf_label_bull := label(na)
        c.c2_chart_label_bull := label(na)
        c.c2_htf_label_bear := label(na)
        c.c2_chart_label_bear := label(na)
        c.cisd_chart_lines := array.new<line>()
        c.max_ltf_c := ltf_c
        c.min_ltf_c := ltf_c
        
        cSet.candles.unshift(c)
        if cSet.candles.size() > 6
            array.pop(cSet.candles)
    else if cSet.candles.size() > 0
        Candle c = cSet.candles.first()
        c.h_time := high > c.h ? time : c.h_time
        c.h_idx := high > c.h ? bar_index : c.h_idx
        c.h := math.max(c.h, high)
        c.l_time := low < c.l ? time : c.l_time
        c.l_idx := low < c.l ? bar_index : c.l_idx
        c.l := math.min(c.l, low)
        c.c := close
        
        c.corr1_h := math.max(nz(c.corr1_h, c1_h), c1_h)
        c.corr1_l := math.min(nz(c.corr1_l, c1_l), c1_l)
        c.corr2_h := math.max(nz(c.corr2_h, c2_h), c2_h)
        c.corr2_l := math.min(nz(c.corr2_l, c2_l), c2_l)
        c.corr3_h := math.max(nz(c.corr3_h, c3_h), c3_h)
        c.corr3_l := math.min(nz(c.corr3_l, c3_l), c3_l)
        
        c.max_ltf_c := math.max(nz(c.max_ltf_c, ltf_c), ltf_c)
        c.min_ltf_c := math.min(nz(c.min_ltf_c, ltf_c), ltf_c)
        
    cSet.DrawSMT(0)

cleanupOldChartMidpointLines() =>
    int max_midpoint_lines = 50
    if chart_midpoint_lines.size() > max_midpoint_lines
        int max_cleanup = math.min(chart_midpoint_lines.size() - max_midpoint_lines, 10)
