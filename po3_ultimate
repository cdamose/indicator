if global_sep_labels_bottom.size() > 0
    for i = 0 to global_sep_labels_bottom.size() - 1
        label.set_y(global_sep_labels_bottom.get(i), abs_bot)
        
if global_sep_labels_top.size() > 0
    for i = 0 to global_sep_labels_top.size() - 1
        label.set_y(global_sep_labels_top.get(i), abs_top)

// ==========================================
// ─── T-SPOT LOGIC ───
// ==========================================
if settings.tspot_show and barstate.islast
    bool allow_bull = settings.bias == "Auto" or settings.bias == "Bullish"
    bool allow_bear = settings.bias == "Auto" or settings.bias == "Bearish"

    while global_tspot_boxes.size() > 0
        box.delete(global_tspot_boxes.pop())
        
    CandleSet targetSet = switch settings.profiler_source
        'HTF1' => htf1
        'HTF2' => htf2
        'HTF3' => htf3
        => htf1 
        
    if settings.profiler_source == 'Auto'
        if auto_profiler_tf == htf1.settings.htf
            targetSet := htf1
        else if auto_profiler_tf == htf2.settings.htf
            targetSet := htf2
        else if auto_profiler_tf == htf3.settings.htf
            targetSet := htf3
            
    if targetSet.candles.size() >= 2
        int draw_limit = settings.tspot_history > 0 ? settings.tspot_history : targetSet.settings.max_display
        int loop_end = math.min(targetSet.candles.size() - 2, draw_limit - 1)
        
        if loop_end >= 0
            for i = 0 to loop_end
                Candle curr_candle = targetSet.candles.get(i)
                Candle prev_candle = targetSet.candles.get(i + 1)
                
                float prev_mid = (prev_candle.h + prev_candle.l) / 2
                
                bool is_bull_tspot = curr_candle.o > prev_mid
                
                float top = math.max(prev_mid, curr_candle.o)
                float bot = math.min(prev_mid, curr_candle.o)
                
                bool hide_tspot = false
                
                if (is_bull_tspot and not allow_bull) or (not is_bull_tspot and not allow_bear)
                    hide_tspot := true
                else
                    int bars_since = bar_index - curr_candle.o_idx
                    int lookback = math.min(bars_since, 4999)
                    
                    if lookback >= 0
                        for b = 0 to lookback
                            if is_bull_tspot and close[b] < bot
                                hide_tspot := true
                                break
                            else if not is_bull_tspot and close[b] > top
                                hide_tspot := true
                                break
                        
                if not hide_tspot
                    int next_period_end = curr_candle.o_time + timeframe.in_seconds(targetSet.settings.htf) * 1000
                    color tspot_col = is_bull_tspot ? settings.tspot_bull : settings.tspot_bear
                    
                    box tspot = box.new(left=curr_candle.o_time, top=top, right=next_period_end, bottom=bot, xloc=xloc.bar_time, border_width=0, bgcolor=tspot_col)
                    global_tspot_boxes.push(tspot)

// ==========================================
// ─── HTF OPEN LINE LOGIC ───
// ==========================================
string target_htf_open_tf = "D"
if settings.profiler_source == 'Auto'
    target_htf_open_tf := auto_profiler_tf
else if settings.profiler_source == 'HTF1'
    target_htf_open_tf := htf1.settings.htf
else if settings.profiler_source == 'HTF2'
    target_htf_open_tf := htf2.settings.htf
else if settings.profiler_source == 'HTF3'
    target_htf_open_tf := htf3.settings.htf

int t_htf_open = time(target_htf_open_tf)
bool isNewHTFOpen = ta.change(t_htf_open) != 0

string open_lbl_txt = ""
int htf_open_secs = timeframe.in_seconds(target_htf_open_tf)
if htf_open_secs > 0 and htf_open_secs <= 43200
    open_lbl_txt := str.format_time(nz(t_htf_open, time), "HH:mm", "America/New_York")
else
    open_lbl_txt := switch target_htf_open_tf
        "D"  => "DO"
        "1D" => "DO"
        "W"  => "WO"
        "1W" => "WO"
        "M"  => "MO"
        "1M" => "MO"
        "3M" => "3MO"
        => helper.HTFName(target_htf_open_tf) + " O"

if settings.htf_open_show
    int target_x2 = bar_index + settings.htf_open_offset
    
    if isNewHTFOpen
        line new_hol = line.new(bar_index, open, target_x2, open, color=settings.htf_open_color, style=helper.LineStyle(settings.htf_open_style), width=settings.htf_open_width)
        global_htf_open_lines.push(new_hol)
        
        label new_hol_lbl = label.new(target_x2, open, settings.htf_open_show_label ? open_lbl_txt : "", color=color_transparent, textcolor=settings.global_text_color, style=label.style_label_left, size=settings.global_text_size)
        global_htf_open_labels.push(new_hol_lbl)

    if global_htf_open_lines.size() > 0
        line.set_x2(global_htf_open_lines.last(), target_x2)
    if global_htf_open_labels.size() > 0
        label.set_x(global_htf_open_labels.last(), target_x2)
        label.set_text(global_htf_open_labels.last(), settings.htf_open_show_label ? open_lbl_txt : "")

    while global_htf_open_lines.size() > settings.htf_open_history
        line.delete(global_htf_open_lines.shift())
        label.delete(global_htf_open_labels.shift())
else
    if global_htf_open_lines.size() > 0
        while global_htf_open_lines.size() > 0
            line.delete(global_htf_open_lines.shift())
            label.delete(global_htf_open_labels.shift())
